{
  "name": "shan-poornam-residence-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive 3D showroom website for Shan Poornam Residence (SP Residence), Madurai",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:artifact": "tsc -b && vite build --mode artifact",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e.cjs",
    "assets": "python3 -I tools/trace_typical_floor.py source-assets/extracted-originals/img-015-015.jpg source-assets/extracted-originals/img-015-016.png tools/plan-geometry.raw.json && python3 -I tools/build_web_assets.py",
    "zip": "python3 -I tools/make_zip.py"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "lucide-react": "1.83.0",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8"
  }
}
